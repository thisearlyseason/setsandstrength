{
  "name": "opengym-frontend",
  "private": true,
  "version": "1.4.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mobile": "VITE_MOBILE=1 vite build && node ../scripts/catalogue/stage-media.mjs dist && cap sync && node scripts/check-mobile-bundle.mjs",
    "preview": "vite preview",
    "test": "VITE_WORKOUT=0 vitest run",
    "test:watch": "VITE_WORKOUT=0 vitest",
    "test:fatigue-probe": "node scripts/fatigue-monotonic-probe.mjs",
    "pdf:check": "node scripts/pdf/render-samples.mjs --out pdf-samples --langs en,de,ar --paper A4,Letter --check",
    "test:fork": "VITE_WORKOUT=0 vitest run src/workout",
    "test:integration": "node scripts/workout-integration.mjs",
    "assets:original": "node scripts/anatomy/illustrations.mjs",
    "assets:upload": "node scripts/workout-assets.mjs",
    "check:coverage": "node ../scripts/workout/check-coverage.mjs",
    "check:release": "node ../scripts/workout/check-coverage.mjs --release",
    "test:anatomy": "node --test scripts/anatomy/tests/*.test.mjs",
    "assets:queue": "node ../scripts/workout/production-queue.mjs",
    "assets:illustrations": "node scripts/anatomy/illustrations.mjs"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@supabase/supabase-js": "^2.118.0",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lean-qr": "^2.7.4",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.187.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "linkedom": "^0.18.13",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
